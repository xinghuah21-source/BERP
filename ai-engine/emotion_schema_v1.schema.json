{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "berp://ai-engine/emotion_schema_v1.schema.json",
  "title": "BERP Emotion Expression Schema v1.0",
  "type": "object",
  "required": ["schema_version", "emotion_expression"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "pipeline_versions": {
      "type": "object",
      "additionalProperties": { "type": ["string", "number", "boolean", "null"] }
    },
    "emotion_expression": {
      "type": "object",
      "required": ["scores", "detected", "audio_quality"],
      "properties": {
        "scores": {
          "type": "object",
          "required": ["arousal_score", "valence_score"],
          "properties": {
            "arousal_score": { "type": "integer", "minimum": 0, "maximum": 100 },
            "valence_score": { "type": "integer", "minimum": 0, "maximum": 100 },
            "style_match": { "type": "integer", "minimum": 0, "maximum": 100 },
            "stability": { "type": "integer", "minimum": 0, "maximum": 100 }
          },
          "additionalProperties": false
        },
        "detected": {
          "type": "object",
          "required": ["labels", "probs", "top1", "av_raw", "confidence"],
          "properties": {
            "labels": {
              "type": "array",
              "items": { "type": "string" },
              "minItems": 2
            },
            "probs": {
              "type": "object",
              "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 }
            },
            "top1": {
              "type": "object",
              "required": ["label", "prob"],
              "properties": {
                "label": { "type": "string" },
                "prob": { "type": "number", "minimum": 0, "maximum": 1 }
              },
              "additionalProperties": false
            },
            "av_raw": {
              "type": "object",
              "required": ["arousal", "valence"],
              "properties": {
                "arousal": { "type": "number", "minimum": 0, "maximum": 1 },
                "valence": { "type": "number", "minimum": 0, "maximum": 1 }
              },
              "additionalProperties": false
            },
            "confidence": {
              "type": "object",
              "required": ["top1", "entropy"],
              "properties": {
                "top1": { "type": "number", "minimum": 0, "maximum": 1 },
                "entropy": { "type": "number", "minimum": 0, "maximum": 1 }
              },
              "additionalProperties": false
            },
            "model": {
              "type": "object",
              "properties": {
                "provider": { "type": "string" },
                "repo_id": { "type": "string" },
                "revision": { "type": "string" }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": false
        },
        "target": {
          "type": ["object", "null"],
          "properties": {
            "poem_title": { "type": "string" },
            "profile": { "type": "string" },
            "tags": { "type": "array", "items": { "type": "string" } },
            "target_av_raw": {
              "type": "object",
              "required": ["arousal", "valence"],
              "properties": {
                "arousal": { "type": "number", "minimum": 0, "maximum": 1 },
                "valence": { "type": "number", "minimum": 0, "maximum": 1 }
              },
              "additionalProperties": false
            },
            "tolerance": {
              "type": "object",
              "properties": {
                "sigma_arousal": { "type": "number", "exclusiveMinimum": 0 },
                "sigma_valence": { "type": "number", "exclusiveMinimum": 0 }
              },
              "additionalProperties": false
            },
            "bandwidth": {
              "type": "object",
              "properties": {
                "arousal_min": { "type": "number", "minimum": 0, "maximum": 1 },
                "arousal_max": { "type": "number", "minimum": 0, "maximum": 1 },
                "valence_min": { "type": "number", "minimum": 0, "maximum": 1 },
                "valence_max": { "type": "number", "minimum": 0, "maximum": 1 }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "match": {
          "type": ["object", "null"],
          "properties": {
            "style_match": { "type": "integer", "minimum": 0, "maximum": 100 },
            "in_target_bandwidth": { "type": "boolean" },
            "distance_from_target": { "type": "number", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "stability": {
          "type": ["object", "null"],
          "properties": {
            "stability": { "type": "integer", "minimum": 0, "maximum": 100 },
            "trajectory": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["time_start", "time_end", "arousal", "valence"],
                "properties": {
                  "time_start": { "type": "number", "minimum": 0 },
                  "time_end": { "type": "number", "minimum": 0 },
                  "arousal": { "type": "number", "minimum": 0, "maximum": 1 },
                  "valence": { "type": "number", "minimum": 0, "maximum": 1 }
                },
                "additionalProperties": false
              }
            },
            "segmentation": {
              "type": "object",
              "additionalProperties": { "type": ["string", "number", "boolean", "null"] }
            }
          },
          "additionalProperties": false
        },
        "audio_quality": {
          "type": "object",
          "required": ["duration_valid"],
          "properties": {
            "duration_seconds": { "type": "number", "minimum": 0 },
            "duration_valid": { "type": "boolean" },
            "speech_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
            "noise_level": { "type": "string", "enum": ["low", "medium", "high", "unknown"] }
          },
          "additionalProperties": true
        },
        "weights_used": {
          "type": ["object", "null"],
          "properties": {
            "emotion_in_total": { "type": "number", "minimum": 0, "maximum": 1 },
            "effective_emotion_weight": { "type": "number", "minimum": 0, "maximum": 1 }
          },
          "additionalProperties": true
        },
        "feedback_rules": {
          "type": ["object", "null"],
          "additionalProperties": { "type": ["string", "number", "boolean", "null"] }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
